{
  "name": "artwork-portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "canva": "npm --prefix canva-app run start:preview",
    "postinstall": "nuxt prepare",
    "webhook": "stripe listen --forward-to http://localhost:3000/api/stripe/webhook",
    "test:drafts:integration": "node --env-file=.env --import tsx --test tests/design-drafts.integration.test.ts",
    "test:workflow:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.workflow.config.ts",
    "test:handoff": "node --import tsx --test tests/agent-handoff.test.ts tests/ai-model.test.ts tests/design-clarifications.test.ts",
    "canva:user-id": "node --import tsx scripts/canva-user-id.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "test:e2e": "playwright test",
    "test:planning": "node --import tsx --test tests/technical-planning.test.ts tests/technical-design-job-worker.test.mjs tests/design-execution.test.mjs tests/design-patch.test.mjs",
    "test:planning:integration": "node --env-file=.env --import tsx --test tests/technical-design-jobs.integration.test.ts",
    "test:verification": "node --test tests/design-verification.test.mjs tests/design-ready-email.test.mjs"
  },
  "dependencies": {
    "@canva/app-middleware": "^0.0.0-beta.8",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/supabase": "^2.0.3",
    "@stripe/stripe-js": "^8.6.1",
    "@supabase/supabase-js": "^2.90.1",
    "file-type": "^21.3.2",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.15",
    "lottie-web": "^5.13.0",
    "nuxt": "^4.2.2",
    "nuxt-lottie": "^1.0.8",
    "nuxt-svgo": "^4.2.6",
    "pinia": "^3.0.4",
    "sharp": "^0.35.5",
    "stripe": "^20.1.2",
    "undici": "^8.12.3",
    "vue": "^3.5.26",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "vue3-lottie": "^3.3.1",
    "zod": "^4.3.5"
  },
  "overrides": {
    "ipx": {
      "sharp": "$sharp"
    }
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "supabase": "3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.8.2"
  }
}
