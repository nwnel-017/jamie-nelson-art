# Server-only AI configuration. Test mode returns a fixed analysis and three questions.
# Switch to chat-completions and supply an API key and image-capable model for real analysis.
NUXT_AI_PROVIDER=test
NUXT_AI_API_KEY=
NUXT_AI_MODEL=
NUXT_AI_BASE_URL=https://api.openai.com/v1

# Local-only convenience: valid Canva tokens are still required. Ignored in production,
# with a real model provider, with hosted Supabase, or when an allowlist is set.
NUXT_CANVA_ALLOW_UNLISTED_LOCAL_USERS=false

# Maximum agent calls per design request, including initial and failed calls
NUXT_MAX_ANALYZE_ATTEMPTS=4
