# Supabase: project URL, public anon key, and server-only service role key.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Storage hostname only (no scheme/path), used by Nuxt image optimization.
SUPABASE_DOMAIN=

# Admin account email; also exposed in public runtime configuration.
ADMIN_EMAIL=

# Stripe: use test credentials while live payments remain disabled.
# The secret key is needed to initialize the existing Stripe client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_ID_DOMESTIC=
STRIPE_SHIPPING_ID_INTERNATIONAL=

# Enable the banner only for preview deployments.
IS_VERCEL_PREVIEW=false

# Canva handoff: comma-separated Canva user IDs allowed to submit designs.
NUXT_CANVA_APP_ID=AAHOGIFETu8
NUXT_CANVA_ALLOWED_USER_IDS=
# Match these to the Canva app if using a different app ID.
NUXT_CANVA_APP_ORIGIN=https://app-aahogifetu8.canva-apps.com
NUXT_CANVA_EXPORT_HOSTS=export-download.canva.com

# Server-only AI configuration. Test mode returns a fixed analysis and three questions.
# Paid analysis supports responses with gpt-4.1-2025-04-14 only.
AI_DESIGN_BUDGET_USD=
NUXT_AI_PROVIDER=test
NUXT_AI_API_KEY=
NUXT_AI_MODEL=
NUXT_AI_BASE_URL=https://api.openai.com/v1

# Local-only convenience: valid Canva tokens are still required. Ignored in production,
# with a real model provider, with hosted Supabase, or when an allowlist is set.
NUXT_CANVA_ALLOW_UNLISTED_LOCAL_USERS=false

# Maximum agent calls per design request, including initial and failed calls
NUXT_MAX_ANALYZE_ATTEMPTS=4

# Approved design implementation worker. Configure these on the backend, not in Canva.
# Fine-grained GitHub token: this repository only, Actions write + Contents read.
NUXT_PLANNING_GITHUB_TOKEN=
NUXT_PLANNING_REPOSITORY=nwnel-017/jamie-nelson-art
NUXT_PLANNING_REPOSITORY_ID=
NUXT_PLANNING_WORKFLOW_REF=master
NUXT_PLANNING_SOURCE_REF=master
NUXT_PLANNING_BACKEND_URL=
NUXT_PLANNING_CODEX_MODEL=
NUXT_PLANNING_GITHUB_WEBHOOK_SECRET=

# GitHub Actions credentials (OPENAI_API_KEY, Resend, and Supabase deployment
# secrets) belong in repository settings; workflows do not load this file.
